import { HttpRequest, HttpResponse, HttpHandler } from '@angular/common/http';
import { TestBed } from '@angular/core/testing';
import { of } from 'rxjs';
import { <FeatureInterceptor> } from './<feature>.interceptor';

describe('<FeatureInterceptor> Interceptor', () => {
  let interceptor: <FeatureInterceptor>;

  beforeEach(() => {
    TestBed.configureTestingModule({
      providers: [<FeatureInterceptor>]
    });

    interceptor = TestBed.inject(<FeatureInterceptor>);
  });

  it('should intercept and forward the request', (done) => {
    const request = new HttpRequest('GET', '/test');
    const next: HttpHandler = {
      handle: (req) => {
        expect(req.url).toBe('/test');
        return of(new HttpResponse({ status: 200 }));
      }
    };

    interceptor.intercept(request, next).subscribe((res) => {
      expect(res.status).toBe(200);
      done();
    });
  });
});
