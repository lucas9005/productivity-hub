{
	"name": "frontend",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"ng": "ng",
		"start:dev": "ng serve --configuration development",
		"start:prod": "ng serve --configuration production",
		"build:dev": "ng build --configuration development",
		"build:prod": "ng build --configuration production",
		"build:dev:watch": "ng build --configuration development --watch",
		"build:prod:watch": "ng build --configuration production --watch",
		"test:unit": "jest",
		"test:unit:watch": "jest --watch",
		"test:unit:coverage": "jest --coverage",
		"test:unit:ci": "jest --ci --runInBand --coverage",
		"test:ci": "jest --ci --runInBand --coverage",
		"test:e2e": "bun x playwright test",
		"test:e2e:ui": "bun x playwright test --ui",
		"test:e2e:debug": "bun x playwright test --debug",
		"test:e2e:report": "bun x playwright show-report",
		"test:e2e:ci": "bun x playwright test",
		"docs": "compodoc -p tsconfig.docs.json -d documentation -s",
		"docs:build": "compodoc -p tsconfig.docs.json -d documentation"
	},
	"dependencies": {
		"@angular/animations": "^19.2.10",
		"@angular/cdk": "^19.2.16",
		"@angular/common": "^19.2.10",
		"@angular/compiler": "^19.2.10",
		"@angular/core": "^19.2.10",
		"@angular/forms": "^19.2.10",
		"@angular/material": "^19.2.16",
		"@angular/platform-browser": "^19.2.10",
		"@angular/platform-browser-dynamic": "^19.2.10",
		"@angular/router": "^19.2.10",
		"modern-normalize": "^3.0.1",
		"rxjs": "^7.8.2",
		"tslib": "^2.8.1",
		"zone.js": "^0.15.0"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "^19.2.12",
		"@angular/cli": "^19.2.12",
		"@angular/compiler-cli": "^19.2.10",
		"@compodoc/compodoc": "^1.1.26",
		"@playwright/test": "^1.52.0",
		"@testing-library/angular": "^17.3.7",
		"@testing-library/jest-dom": "^6.6.3",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.15.29",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"jest-preset-angular": "^14.5.5",
		"ts-jest": "^29.3.3",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3"
	}
}
