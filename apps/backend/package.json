{
	"name": "backend",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"start:dev": "ts-node-dev --respawn --transpile-only --project tsconfig.dev.json src/main.ts",
		"start:prod": "ts-node-dev --respawn --transpile-only --project tsconfig.prod.json src/main.ts",
		"build:dev": "tsc --project tsconfig.dev.json",
		"build:prod": "tsc --project tsconfig.prod.json",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:ci": "jest --ci --runInBand --coverage",
		"test:e2e": "jest --config ./e2e/jest-e2e.json",
		"docs": "bun run docs:build && bunx serve -l 4000 documentation",
		"docs:build": "typedoc --options typedoc.config.js"
	},
	"dependencies": {
		"@nestjs/common": "^11.1.0",
		"@nestjs/core": "^11.1.0",
		"@nestjs/platform-express": "^11.1.0",
		"@nestjs/swagger": "^11.2.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"swagger-ui-express": "^5.0.1"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.7",
		"@nestjs/schematics": "^11.0.5",
		"@nestjs/testing": "^11.1.0",
		"@types/express": "^5.0.1",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.15.17",
		"@types/supertest": "^6.0.3",
		"jest": "^29.7.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.1.0",
		"ts-jest": "^29.3.2",
		"ts-node-dev": "^2.0.0",
		"tsconfig-paths": "^4.2.0",
		"typedoc": "^0.28.4",
		"typescript": "^5.8.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
