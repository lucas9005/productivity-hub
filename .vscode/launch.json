{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug Frontend (Angular)",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/apps/frontend"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend (NestJS)",
      "runtimeExecutable": "bunx",
      "runtimeArgs": ["ts-node", "--inspect-brk", "src/main.ts"],
      "cwd": "${workspaceFolder}/apps/backend",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
